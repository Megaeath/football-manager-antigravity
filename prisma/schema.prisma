generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model League {
  id      String          @id @default(cuid())
  name    String
  level   Int             @default(1)
  season  Int             @default(1)
  teams   Team[]
  history SeasonHistory[]

  @@unique([level, season])
}

model GlobalGameSettings {
  id                Int      @id @default(1)
  currentDate       DateTime @default(dbgenerated("'2026-01-01'"))
  currentSeason     Int      @default(1)
  isConfigured      Boolean  @default(false)
  userTeamId        String?
  lastExpDecayMonth Int      @default(0)
  yellowSuspensionThreshold Int @default(4)
}

model SeasonHistory {
  id        String  @id @default(cuid())
  leagueId  String
  season    Int
  year      Int
  standings String // JSON string of the final table
  winnerId  String?
  league    League  @relation(fields: [leagueId], references: [id])
}

model Team {
  id       String  @id @default(cuid())
  name     String
  leagueId String?
  league   League? @relation(fields: [leagueId], references: [id])
  lastDivisionChangeSeason Int?

  // Tactics
  formation        String @default("4-4-2")
  mentality        String @default("NORMAL")
  passing          String @default("MIXED")
  tackling         String @default("NORMAL")
  attacking_focus  String @default("MIXED")
  creative_freedom String @default("NORMAL")
  aiPlaystyleProfileId String?
  aiPlaystyleLocked    Boolean @default(false)
  trainingFacilityLevel Int @default(1)

  // Financial & Reputation
  balance         Int @default(5000000) // Current cash balance
  reputation      Int @default(50) // 0-100
  stadiumCapacity Int @default(50000) // Stadium seats

  // AI Market Processing (distributed by day)
  lastAIMarketProcessedDate DateTime?

  // Relations
  players        Player[]
  homeMatches    Match[]           @relation("HomeTeam")
  awayMatches    Match[]           @relation("AwayTeam")
  ClubFinance    ClubFinance[]
  TeamReputation TeamReputation[]
  FinancialEvent FinancialEvent[]
  tactics        TeamTactics?
  bidsMade       Bid[]             @relation("BidsMade")
  bidsReceived   Bid[]             @relation("BidsReceived")
  news           News[]
  transfersFrom  TransferHistory[] @relation("TransferFrom")
  transfersTo    TransferHistory[] @relation("TransferTo")
  trainingAssignments TrainingAssignment[]
  trainingLedgers     TrainingWeeklyLedger[]
  swissStandings      SwissStanding[]
}

model Player {
  id     String  @id @default(cuid())
  name   String
  age    Int
  teamId String? // Nullable for free agents

  // Primary Position (Natural)
  naturalPosition String // Stored as string, e.g. "GK", "FWR"

  // Attributes (0-20) - Technical
  handling  Int @default(5)
  tackling  Int
  passing   Int
  shooting  Int
  heading   Int
  dribbling Int
  crossing  Int @default(10)
  setPieces Int
  throw     Int @default(10)

  // Attributes (0-20) - Mental
  aggression  Int
  positioning Int
  vision      Int
  bravery     Int
  leadership  Int
  teamwork    Int
  composure   Int

  // Experience System
  exp Int @default(0) // Total accumulated EXP (max 1000)

  // Attributes (0-20) - Physical
  pace         Int
  acceleration Int
  stamina      Int @default(15)
  strength     Int
  agility      Int
  balance      Int

  // Dynamic State
  morale           Int     @default(100)
  condition        Int     @default(100) // Match Fitness (0-100)
  suspensionMatchesRemaining Int @default(0)
  yellowCardAccumulation Int @default(0)
  injuryWeeksRemaining Int @default(0)
  injurySeverity   String?
  tacticalPosition String? // E.g. "GK", "DR", "DC_L", "DC_R", "FW_L", "FW_R" - if null, not starting

  // Player Role System
  playerRole          String? // NULL = no role assigned | Values: "PLAYMAKER", "TARGET_MAN", etc.
  attackingRolePreset String? // In-possession role preset
  defensiveRolePreset String? // Out-of-possession role preset

  // Stats (Season Aggregate)
  goals       Int   @default(0)
  assists     Int   @default(0)
  apps        Int   @default(0)
  yellowCards Int   @default(0)
  redCards    Int   @default(0)
  avgRating   Float @default(0.0)

  // Season Stats (Aggregates)
  passesAttempted  Int @default(0)
  passesCompleted  Int @default(0)
  crossesAttempted Int @default(0)
  crossesCompleted Int @default(0)
  freeKicks        Int @default(0)
  corners          Int @default(0)
  throws           Int @default(0)

  // Aging & Retirement
  birthDate     DateTime @default(now())
  retirementAge Int      @default(38)
  isRetired     Boolean  @default(false)
  motmCount     Int      @default(0)

  // Financial & Reputation
  popularity        Int @default(50) // 0-100
  contractStartWeek Int @default(0) // Week when contract started (for tracking duration)
  contractEndWeek   Int @default(52) // Weeks until contract expires
  weeklyWage        Int @default(10000) // Currency units per week

  // Market & Status
  transferStatus        String @default("NOT_LISTED") // LISTED, NOT_LISTED
  askingPrice           Int?
  squadStatus           String @default("ROTATION") // KEY_PLAYER, ROTATION, BACKUP, STAR, WORLD_CLASS
  lastTransferredSeason Int    @default(0)

  // Relations
  matchStats       PlayerMatchStats[]
  actionLogs       PlayerActionLog[]
  team             Team?              @relation(fields: [teamId], references: [id])
  motmMatches      Match[]            @relation("MatchMotM")
  PlayerReputation PlayerReputation[]
  bids             Bid[]
  transferHistory  TransferHistory[]
  trainingAssignments TrainingAssignment[]
  trainingFractions PlayerTrainingFraction[]

  // Indexes for AI Market queries
  @@index([transferStatus, isRetired])
  @@index([teamId, isRetired])
  @@index([age, transferStatus])
  @@index([lastTransferredSeason])
}

model TrainingAssignment {
  id             String   @id @default(cuid())
  teamId         String
  playerId       String?
  slotIndex      Int
  focusAttribute String?
  isActive       Boolean  @default(false)
  lastGain       Float    @default(0)
  updatedAt      DateTime @updatedAt

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([teamId, slotIndex])
  @@index([teamId, playerId])
}

model PlayerTrainingFraction {
  id          String @id @default(cuid())
  playerId    String
  attribute   String
  remainder   Float  @default(0)
  lifetimeGain Float @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, attribute])
}

model TrainingWeeklyLedger {
  id          String   @id @default(cuid())
  teamId      String
  weekKey     Int
  status      String
  chargedFee  Int      @default(0)
  processedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, weekKey])
}

model Match {
  id         String   @id @default(cuid())
  date       DateTime
  season     Int      @default(1)
  competitionType String @default("LEAGUE") // LEAGUE | CUP
  competitionPhase String? // SWISS | KNOCKOUT
  competitionRound Int?
  cupTournamentId  String?
  homeTeamId String
  awayTeamId String
  homeScore  Int?
  awayScore  Int?
  isPlayed   Boolean  @default(false)
  wentToExtraTime Boolean @default(false)
  wentToPenalties Boolean @default(false)
  penaltyHome Int?
  penaltyAway Int?

  // Match-Specific Tactics (override team default tactics)
  homeTactics_formation        String?
  homeTactics_mentality        String?
  homeTactics_passing          String?
  homeTactics_tackling         String?
  homeTactics_attacking_focus  String?
  homeTactics_creative_freedom String?

  awayTactics_formation        String?
  awayTactics_mentality        String?
  awayTactics_passing          String?
  awayTactics_tackling         String?
  awayTactics_attacking_focus  String?
  awayTactics_creative_freedom String?

  // Match Preparation Config (JSON-encoded MatchPrepConfig)
  homePrepConfig String? // Match-specific prep: neutralization, press traps, transition rules
  awayPrepConfig String? // Separate prep for away team

  // Awards
  motmPlayerId String?
  motmPlayer   Player? @relation("MatchMotM", fields: [motmPlayerId], references: [id])
  stats        String? // JSON string: { home: { possession, corners, offsides, fouls, yellow, red, passes, shots }, away: { ... } }

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id])
  cupTournament CupTournament? @relation(fields: [cupTournamentId], references: [id])

  events      MatchEvent[]
  playerStats PlayerMatchStats[]
  actionLogs  PlayerActionLog[]

  @@index([season, competitionType, date])
  @@index([cupTournamentId, competitionRound])
  @@index([season])  // For ranking queries
}

model CupTournament {
  id            String   @id @default(cuid())
  season        Int      @unique
  status        String   @default("ACTIVE") // ACTIVE | FINISHED
  phase         String   @default("SWISS") // SWISS | KNOCKOUT
  currentRound  Int      @default(1)
  startDate     DateTime
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matches       Match[]
  standings     SwissStanding[]
  matchHistory  SwissMatchHistory[]
}

model SwissStanding {
  id            String   @id @default(cuid())
  tournamentId  String
  teamId        String
  played        Int      @default(0)
  win           Int      @default(0)
  draw          Int      @default(0)
  loss          Int      @default(0)
  points        Int      @default(0)
  gd            Int      @default(0)
  gf            Int      @default(0)
  buchholzScore Int      @default(0)
  form          String   @default("")
  updatedAt     DateTime @updatedAt

  tournament CupTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@index([tournamentId, points, buchholzScore, gd, gf])
}

model SwissMatchHistory {
  id            String   @id @default(cuid())
  tournamentId  String
  teamAId       String
  teamBId       String
  createdAt     DateTime @default(now())

  tournament CupTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamAId, teamBId])
  @@index([tournamentId])
}

model MatchEvent {
  id       String  @id @default(cuid())
  matchId  String
  minute   Int
  text     String
  type     String
  teamId   String?
  playerId String?
  match    Match   @relation(fields: [matchId], references: [id])
}

model PlayerMatchStats {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  teamId   String

  // Performance
  rating  Float @default(6.0) // 1-10
  minutes Int   @default(0)
  goals   Int   @default(0)
  assists Int   @default(0)

  // Detailed Stats
  passesAttempted   Int @default(0)
  passesCompleted   Int @default(0)
  crossesAttempted  Int @default(0)
  crossesCompleted  Int @default(0)
  shots             Int @default(0)
  shotsOnTarget     Int @default(0)
  tacklesAttempted  Int @default(0)
  tacklesWon        Int @default(0)
  dribblesAttempted Int @default(0)
  dribblesWon       Int @default(0)
  saves             Int @default(0) // GK
  fouls             Int @default(0)
  yellowCards       Int @default(0)
  redCards          Int @default(0)
  freeKicks         Int @default(0)
  corners           Int @default(0)
  throws            Int @default(0)
  fitnessEnd        Int @default(100) // End-of-match fitness (0-100)

  // Field usage tracking by thirds
  defensiveThirdTouches Int @default(0) // 1-30
  middleThirdTouches    Int @default(0) // 31-70
  attackingThirdTouches Int @default(0) // 71-100

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  // Indexes for ranking queries
  @@index([matchId, playerId])
}

model PlayerActionLog {
  id                  String   @id @default(cuid())
  matchId             String
  playerId            String
  teamId              String
  minute              Int
  ballPosition        Int // 0-100 field position
  zone                String // DEFENSIVE | MIDDLE | ATTACKING
  actionType          String // PASS_SHORT | PASS_LONG | DRIBBLE | SHOOT | TACKLE | SAVE | INTERCEPTION | FOUL
  result              String // SUCCESS | FAIL | GOAL | SAVED | BLOCKED | OFF_TARGET
  isSuccessful        Boolean
  expectedSuccessRate Float? // 0-1 expected probability for this action
  targetPlayerId      String?
  metadata            String? // JSON string for extensible raw context
  createdAt           DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@index([matchId, playerId])
  @@index([playerId, actionType])
  @@index([teamId, zone])
}

// ========== FINANCIAL SYSTEM MODELS ==========

model PlayerReputation {
  id          String   @id @default(cuid())
  playerId    String
  week        Int
  popularity  Int      @default(50) // 0-100
  trendChange Int      @default(0) // Change from previous week
  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, week])
}

model TeamReputation {
  id          String   @id @default(cuid())
  teamId      String
  week        Int
  reputation  Int      @default(50) // 0-100
  trendChange Int      @default(0) // Change from previous week
  createdAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, week])
}

model ClubFinance {
  id             String   @id @default(cuid())
  teamId         String
  week           Int
  balance        Int // Current cash balance after this week
  weeklyIncome   Int // Income for this week
  weeklyExpenses Int // Expenses for this week
  createdAt      DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, week])
}

model TeamTactics {
  id     String @id @default(cuid())
  teamId String @unique

  // Normal Plan (แผนปกติ - ใช้เมื่อเสมอกัน)
  normalFormation        String @default("4-4-2")
  normalMentality        String @default("NORMAL")
  normalPassing          String @default("MIXED")
  normalTackling         String @default("NORMAL")
  normalAttacking_focus  String @default("MIXED")
  normalCreative_freedom String @default("NORMAL")

  // Behind Plan (แผนตามไป - ใช้เมื่อทีมตามไป)
  behindFormation        String @default("4-4-2")
  behindMentality        String @default("ALL_OUT_ATTACK")
  behindPassing          String @default("DIRECT")
  behindTackling         String @default("HARD")
  behindAttacking_focus  String @default("WINGS")
  behindCreative_freedom String @default("MAXIMUM")

  // Leading Plan (แผนนำหน้า - ใช้เมื่อทีมนำหน้า)
  leadingFormation        String @default("4-4-2")
  leadingMentality        String @default("ULTRA_DEFENSIVE")
  leadingPassing          String @default("SHORT")
  leadingTackling         String @default("HARD")
  leadingAttacking_focus  String @default("CENTER")
  leadingCreative_freedom String @default("NORMAL")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model FinancialEvent {
  id          String   @id @default(cuid())
  teamId      String
  date        DateTime @default(now())
  type        String // 'WAGE', 'SPONSORSHIP', 'TICKET', 'JERSEY', 'MAINTENANCE', 'OTHER'
  amount      Int // Positive = income, Negative = expense
  description String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ========== TRANSFER MARKET MODELS ==========

model Bid {
  id          String   @id @default(cuid())
  playerId    String
  fromTeamId  String
  toTeamId    String
  amount      Int
  status      String   @default("PENDING") // PENDING, REJECTED, ACCEPTED
  isFreeAgent Boolean  @default(false)
  signOnBonus Int      @default(0)
  createdAt   DateTime @default(now())
  windowEnds  DateTime
  season      Int      @default(1)

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromTeam Team   @relation("BidsMade", fields: [fromTeamId], references: [id], onDelete: Cascade)
  toTeam   Team   @relation("BidsReceived", fields: [toTeamId], references: [id], onDelete: Cascade)

  // Indexes for AI Market queries
  @@index([status, windowEnds])
  @@index([playerId, status])
}

model News {
  id      String   @id @default(cuid())
  date    DateTime @default(now())
  title   String
  content String
  teamId  String?
  type    String   @default("GLOBAL") // GLOBAL, TRANSFER, MATCH, etc.
  isRead  Boolean  @default(false)

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model TransferHistory {
  id         String   @id @default(cuid())
  playerId   String
  fromTeamId String? // Null for initial generation or free agents
  toTeamId   String
  season     Int
  date       DateTime
  fee        Int      @default(0)

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromTeam Team?  @relation("TransferFrom", fields: [fromTeamId], references: [id])
  toTeam   Team   @relation("TransferTo", fields: [toTeamId], references: [id])
}
